# ==========================================
# CẤU HÌNH DỰ ÁN AI INVESTMENT FUND
# Hãy copy file này thành .env và điền thông tin của bạn
# ==========================================

# 1. Cấu hình Google Cloud & BigQuery (Tận dụng Cloud Run của bạn)
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=vietnam_stocks
BIGQUERY_TABLE_ADJ=adj_price
BIGQUERY_TABLE_RAW=raw_price
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service_account_key.json

# 2. Vốn & Tham số Vận hành Quỹ
INITIAL_CAPITAL=1000000000
BROKER_FEE_RATE=0.0015
SELL_TAX_RATE=0.0010
MAX_POSITION_PCT=0.20
HARD_STOP_LOSS_PCT=0.07

# 3. Cấu hình Telegram Bot (Nhận thông báo & duyệt lệnh)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
